import sys
import gc

class University:
    def __init__(self, name):
        self.university_name = name
        self.students = []

    class Student:
        def __init__(self, rollno, name, university):
            self.rollno = rollno
            self.name = name
            self.university = university

        def display(self):
            print(self.rollno, self.name, "-", self.university.university_name)

    def add_student(self, rollno, name):
        s = self.Student(rollno, name, self)
        self.students.append(s)
        print("Ref count:", sys.getrefcount(s)-1)

    def remove_student(self, rollno):
        for s in self.students:
            if s.rollno == rollno:
                self.students.remove(s)
                del s
                gc.collect()
                print("Student removed")
                break

    def display_all(self):
        print("\n--- Students List ---")
        for s in self.students:
            s.display()
uname = input("Enter university name: ")
u = University(uname)

n = int(input("Enter number of students to add: "))

for i in range(n):
    roll = int(input("Enter roll number: "))
    name = input("Enter student name: ")
    u.add_student(roll, name)

u.display_all()

m = int(input("\nEnter number of students to remove: "))

for i in range(m):
    roll = int(input("Enter roll number to remove: "))
    u.remove_student(roll)

u.display_all()

print("\nUniversity ref count:", sys.getrefcount(u)-1)
gc.collect()
print("Garbage collection done")
